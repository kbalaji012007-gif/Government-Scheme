# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
PYTHON_VERSION=3.12.0

# Firebase Cloud Firestore Configuration
FIREBASE_PROJECT_ID=ruralconnect-karnataka
FIREBASE_DATABASE_ID=(default)
# Paste the content of your Firebase Service Account JSON key below (or as a single-line string):
FIREBASE_CREDENTIALS_JSON=

# Authentication Secrets
SECRET_KEY=ruralconnect_karnataka_super_secret_jwt_development_key_change_in_prod_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated frontend origins)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
